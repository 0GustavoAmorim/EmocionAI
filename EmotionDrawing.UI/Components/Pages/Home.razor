@page "/"
@rendermode InteractiveServer

<PageTitle>Emotion Drawing - Desenhos e Emoções</PageTitle>

<style>
    .home-container {
        background-color: #f5f9ff;
    }

    .header-card {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        border-radius: 25px;
        color: white;
        overflow: hidden;
    }

    .kid-title {
        font-family: 'Comic Sans MS', cursive, sans-serif;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }

    .info-card {
        border-radius: 20px;
        transition: transform 0.3s;
    }

        .info-card:hover {
            transform: translateY(-5px);
        }

    .header-illustration {
        position: absolute;
        right: -50px;
        top: -20px;
        font-size: 180px;
        opacity: 0.1;
    }

    .tech-card {
        border-radius: 15px;
        transition: all 0.3s;
        height: 100%;
    }

        .tech-card:hover {
            transform: scale(1.02);
            box-shadow: 0 6px 15px rgba(0,0,0,0.1);
        }

    .tech-icon {
        font-size: 36px;
        margin-bottom: 10px;
    }

    .action-section {
        border-radius: 20px;
        background-color: #fff6e6;
        border: 3px dashed #ffb347;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 home-container">
    <MudGrid>
        <MudItem xs="12">
            <MudCard Elevation="3" Class="mb-6 header-card">
                <div class="header-illustration">
                    <MudIcon Icon="@Icons.Material.Filled.ChildCare" />
                </div>
                <MudCardContent Class="pa-8">
                    <MudGrid>
                        <MudItem xs="12" md="8">
                            <MudText Typo="Typo.h2" Class="kid-title mb-2">Emotion Drawing</MudText>
                            <MudText Typo="Typo.h5" Class="mb-4">Descubra as emoções nos desenhos das crianças</MudText>

                            <MudText Typo="Typo.body1" Class="mt-4">
                                O projeto <strong>Emotion Drawing</strong> usa inteligência artificial para identificar
                                emoções nos desenhos infantis. É uma forma divertida de entender como as crianças
                                expressam seus sentimentos através da arte.
                            </MudText>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Secondary"
                                       Size="Size.Large"
                                       Class="mt-4"
                                       Href="#upload-section">
                                <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Class="mr-2" />
                                Testar Agora
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.h4" Class="kid-title mb-4" Color="Color.Primary">Como Funciona</MudText>

            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudCard Elevation="2" Class="info-card">
                        <MudCardContent Class="pa-6 d-flex flex-column align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Draw" Color="Color.Primary" Size="Size.Large" Class="mb-3" />
                            <MudText Typo="Typo.h5" Class="kid-title" Align="Align.Center">1. Desenhe</MudText>
                            <MudText Typo="Typo.body1" Align="Align.Center" Class="mt-2">
                                Peça à criança para desenhar algo que expresse uma emoção, como alegria, tristeza ou surpresa
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudCard Elevation="2" Class="info-card">
                        <MudCardContent Class="pa-6 d-flex flex-column align-center">
                            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Secondary" Size="Size.Large" Class="mb-3" />
                            <MudText Typo="Typo.h5" Class="kid-title" Align="Align.Center">2. Envie</MudText>
                            <MudText Typo="Typo.body1" Align="Align.Center" Class="mt-2">
                                Tire uma foto do desenho ou digitalize-o e envie para nossa plataforma analisar
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudCard Elevation="2" Class="info-card">
                        <MudCardContent Class="pa-6 d-flex flex-column align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Psychology" Color="Color.Tertiary" Size="Size.Large" Class="mb-3" />
                            <MudText Typo="Typo.h5" Class="kid-title" Align="Align.Center">3. Descubra</MudText>
                            <MudText Typo="Typo.body1" Align="Align.Center" Class="mt-2">
                                Nossa IA analisará o desenho e identificará as emoções expressas, mostrando resultados em porcentagem
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudItem>

        <MudItem xs="12" Class="mt-6">
            <MudText Typo="Typo.h4" Class="kid-title mb-4" Color="Color.Primary">Tecnologias Educativas</MudText>

            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="0" Outlined="true" Class="pa-4 tech-card">
                        <MudCardContent Class="d-flex flex-column align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Primary" Class="tech-icon" />
                            <MudText Typo="Typo.h6" Class="kid-title" Align="Align.Center">Blazor .NET 9</MudText>
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">
                                Tecnologia moderna que permite criar interfaces interativas e divertidas para crianças
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="0" Outlined="true" Class="pa-4 tech-card">
                        <MudCardContent Class="d-flex flex-column align-center">
                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Secondary" Class="tech-icon" />
                            <MudText Typo="Typo.h6" Class="kid-title" Align="Align.Center">Azure Custom Vision</MudText>
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">
                                Inteligência artificial que aprende a reconhecer padrões emocionais nos desenhos infantis
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="0" Outlined="true" Class="pa-4 tech-card">
                        <MudCardContent Class="d-flex flex-column align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Palette" Color="Color.Tertiary" Class="tech-icon" />
                            <MudText Typo="Typo.h6" Class="kid-title" Align="Align.Center">MudBlazor</MudText>
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">
                                Componentes coloridos e animados que tornam a experiência mais divertida para as crianças
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudItem>

        <MudItem xs="12" Class="mt-6 mb-8" id="upload-section">
            <MudCard Elevation="3" Class="action-section">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h4" Class="kid-title" Color="Color.Secondary">
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" />
                            Hora de Testar!
                        </MudText>
                        <MudText Typo="Typo.body1">
                            Envie o desenho da criança e veja qual emoção a IA consegue identificar
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <EmotionDrawing.UI.Components.UploadDraw />
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>
