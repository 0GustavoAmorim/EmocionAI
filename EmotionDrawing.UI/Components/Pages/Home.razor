@page "/"
@rendermode InteractiveServer

<PageTitle>EmocionAI - Desenhos e Emoções</PageTitle>

<style>
    body, .home-bg {
        background: linear-gradient(120deg, #f5f9ff 60%, #ffe7fa 100%);
        min-height: 100vh;
    }

    .header-simple {
        text-align: left;
        margin-left: 32px;
        margin-top: 32px;
        margin-bottom: 32px;
        max-width: 700px;
    }

        .header-simple .header-illustration {
            font-size: 60px;
            opacity: 0.13;
            margin-bottom: 0.3rem;
            color: #8c52ff;
            display: block;
        }

        .header-simple .kid-title {
            font-family: 'Comic Sans MS', 'Baloo 2', cursive, sans-serif;
            color: #8c52ff;
            font-size: 2.3rem;
            margin-bottom: 8px;
            text-shadow: 2px 2px 6px #e0d6ff;
            letter-spacing: 1px;
        }

        .header-simple .subtitle {
            color: #5b3e96;
            font-size: 1.25rem;
            margin-bottom: 14px;
            font-family: 'Comic Sans MS', 'Baloo 2', cursive, sans-serif;
            text-shadow: 1px 1px 4px #e0d6ff;
        }

        .header-simple .desc {
            color: #7a5fa0;
            font-size: 1.08rem;
            margin-bottom: 16px;
            margin-right: 16px;
            line-height: 1.6;
            max-width: 600px;
        }

        .header-simple .start-btn {
            margin-top: 10px;
            font-size: 1rem;
            padding: 8px 24px;
        }

    .info-card {
        border-radius: 25px;
        background: #fffbe7;
        box-shadow: 0 2px 12px rgba(255,222,89,0.10);
        transition: transform 0.3s;
    }

        .info-card:hover {
            transform: translateY(-8px) scale(1.03);
            box-shadow: 0 8px 24px rgba(255,222,89,0.18);
        }

    .action-section {
        border-radius: 25px;
        background: linear-gradient(90deg, #fff6e6 80%, #ffe7fa 100%);
        border: 4px dashed #ffb347;
        box-shadow: 0 2px 12px rgba(255,179,71,0.10);
        position: relative;
    }
</style>

<!-- Header principal simples e integrado -->
<div class="header-simple">
  
    <MudText Typo="Typo.h2" Class="kid-title">
        <span class="">
            <MudIcon Icon="@Icons.Material.Filled.ChildCare" />
        </span> - EmocionAI
    </MudText>
    <MudText Typo="Typo.h5" Class="subtitle">Descubra as emoções nos desenhos das crianças</MudText>
    <MudText Typo="Typo.body1" Class="desc">
        O projeto <strong>EmocionAI</strong> usa inteligência artificial para identificar
        emoções nos desenhos infantis. É uma forma divertida de entender como as crianças
        expressam seus sentimentos através da arte.
    </MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Secondary"
               Size="Size.Medium"
               Class="start-btn"
               Href="#upload-section">
        <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Class="mr-2" />
        Testar Agora
    </MudButton>
</div>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 home-bg">
    <MudGrid>
        <MudItem xs="12">
            <MudText Typo="Typo.h4" Class="kid-title mb-4" Color="Color.Primary">Como Funciona</MudText>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudCard Elevation="2" Class="info-card">
                        <MudCardContent Class="pa-6 d-flex flex-column align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Draw" Color="Color.Primary" Size="Size.Large" Class="mb-3" />
                            <MudText Typo="Typo.h5" Class="kid-title" Align="Align.Center">1. Desenhe</MudText>
                            <MudText Typo="Typo.body1" Align="Align.Center" Class="mt-2">
                                Peça à criança para desenhar algo que expresse o que ela está sentindo
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudCard Elevation="2" Class="info-card">
                        <MudCardContent Class="pa-6 d-flex flex-column align-center">
                            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Secondary" Size="Size.Large" Class="mb-3" />
                            <MudText Typo="Typo.h5" Class="kid-title" Align="Align.Center">2. Envie</MudText>
                            <MudText Typo="Typo.body1" Align="Align.Center" Class="mt-2">
                                Tire uma foto do desenho e envie para nossa plataforma analisar
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudCard Elevation="2" Class="info-card">
                        <MudCardContent Class="pa-6 d-flex flex-column align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Psychology" Color="Color.Tertiary" Size="Size.Large" Class="mb-3" />
                            <MudText Typo="Typo.h5" Class="kid-title" Align="Align.Center">3. Descubra</MudText>
                            <MudText Typo="Typo.body1" Align="Align.Center" Class="mt-2">
                                Nossa IA analisará o desenho e identificará as emoções expressas, mostrando resultados em porcentagem
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudItem>

        <MudItem xs="12" Class="mt-6 mb-8" id="upload-section">
            <MudCard Elevation="3" Class="action-section">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h4" Class="kid-title" Color="Color.Secondary">
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" />
                            Hora de Testar!
                        </MudText>
                        <MudText Typo="Typo.body1">
                            Envie o desenho da criança e veja qual emoção a IA consegue identificar
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <EmotionDrawing.UI.Components.UploadDraw />
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>
